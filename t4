def tanh(x): e=math.exp(2*x);return(e-1)/(e+1)
def sig(x): return 1/(1+math.exp(-x))

# Vanilla RNN: h_t = tanh(Wx@x + Wh@h + b)
def rnn(x,h,Wx,Wh,b):
    z=[sum(Wx[i][j]*x[j] for j in range(len(x)))+sum(Wh[i][j]*h[j] for j in range(len(h)))+b[i] for i in range(len(b))]
    return[tanh(v) for v in z]

# LSTM: f=sig(W[h,x]+b); i=sig; g=tanh; o=sig; c=f*c+i*g; h=o*tanh(c)
# GRU: r=sig; z=sig; h̃=tanh(Wh@[r*h,x]); h=(1-z)*h+z*h̃
