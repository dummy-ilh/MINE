class Adam:
    def __init__(self,lr=.001,b1=.9,b2=.999,e=1e-8):
        self.lr=lr;self.b1=b1;self.b2=b2;self.e=e;self.m=self.v=None;self.t=0
    def step(self,p,g):
        if not self.m: self.m=[0.]*len(p);self.v=[0.]*len(p)
        self.t+=1
        for i in range(len(p)):
            self.m[i]=self.b1*self.m[i]+(1-self.b1)*g[i]
            self.v[i]=self.b2*self.v[i]+(1-self.b2)*g[i]**2
            mh=self.m[i]/(1-self.b1**self.t);vh=self.v[i]/(1-self.b2**self.t)
            p[i]-=self.lr*mh/(vh**.5+self.e)
        return p

# SGD+momentum: v=β·v-lr·g; p+=v
# Grad clip: scale=max_norm/norm(g); g=[gi*scale for gi in g] if norm>max_norm
# LR cosine: lr_min+.5*(lr_max-lr_min)*(1+cos(π·t/T))
# LR warmup (transformer): d^-0.5 * min(step^-0.5, step·warmup^-1.5)
