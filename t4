## J. BACKPROP
```python
# Grad of activations:
# ReLU: 1 if x>0 else 0
# Sigmoid: s*(1-s)
# Tanh: 1-tanh(x)²
# Softmax+CE combined: pred - y_onehot  ← use this, not separate
# MSE grad: 2*(pred-y)/n
# BCE grad: (pred-y)/(pred*(1-pred))

# MLP backward (1 hidden layer)
def backward(self,y):
    n=len(self.z2);dz2=[(self.z2[i]-y[i])*2/n for i in range(n)]
    for i in range(len(self.W2)):
        for j in range(len(self.W2[0])): self.W2[i][j]-=self.lr*dz2[i]*self.a1[j]
        self.b2[i]-=self.lr*dz2[i]
    da1=[sum(self.W2[i][j]*dz2[i] for i in range(n)) for j in range(len(self.a1))]
    dz1=[da1[i]*(1 if self.z1[i]>0 else 0) for i in range(len(self.z1))]
    for i in range(len(self.W1)):
        for j in range(len(self.W1[0])): self.W1[i][j]-=self.lr*dz1[i]*self.x[j]
        self.b1[i]-=self.lr*dz1[i]
