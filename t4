            for j in range(ow)] for i in range(oh)]
def maxpool(x,p=2,s=2):
    oh,ow=(len(x)-p)//s+1,(len(x[0])-p)//s+1
    return[[max(x[i*s+ki][j*s+kj] for ki in range(p) for kj in range(p))
            for j in range(ow)] for i in range(oh)]
def avgpool(x,p=2,s=2):
    oh,ow=(len(x)-p)//s+1,(len(x[0])-p)//s+1
    return[[sum(x[i*s+ki][j*s+kj] for ki in range(p) for kj in range(p))/(p*p)
            for j in range(ow)] for i in range(oh)]
def gap(x): return sum(x[i][j] for i in range(len(x)) for j in range(len(x[0])))/(len(x)*len(x[0]))
