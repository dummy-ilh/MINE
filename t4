# TF-IDF
def tfidf(docs):
    N=len(docs)
    tf=[{w:doc.count(w)/len(doc) for w in set(doc)} for doc in docs]
    vocab=set(w for d in docs for w in d)
    idf={w:math.log(N/(1+sum(1 for d in tf if w in d))) for w in vocab}
    return[{w:t*idf[w] for w,t in d.items()} for d in tf]

def jaccard(a,b): a,b=set(a),set(b);return len(a&b)/len(a|b) if a|b else 0

def levenshtein(s,t):
    m,n=len(s),len(t);dp=[[0]*(n+1) for _ in range(m+1)]
    for i in range(m+1): dp[i][0]=i
    for j in range(n+1): dp[0][j]=j
    for i in range(1,m+1):
        for j in range(1,n+1):
            dp[i][j]=dp[i-1][j-1] if s[i-1]==t[j-1] else 1+min(dp[i-1][j],dp[i][j-1],dp[i-1][j-1])
    return dp[m][n]

def welford(stream):  # online mean+variance
    n=mn=M2=0.
    for x in stream:
        n+=1;d=x-mn;mn+=d/n;M2+=d*(x-mn)
    return mn,M2/(n-1) if n>1 else 0

def median_stream():
    lo,hi=[],[]  # lo=max-heap(neg), hi=min-heap
    def add(x):
        heapq.heappush(lo,-x);heapq.heappush(hi,-heapq.heappop(lo))
        if len(hi)>len(lo): heapq.heappush(lo,-heapq.heappop(hi))
    def get(): return-lo[0] if len(lo)>len(hi) else(-lo[0]+hi[0])/2
    return add,get

def ngrams(tok,n): return[tuple(tok[i:i+n]) for i in range(len(tok)-n+1)]
def bow(docs):
    v=sorted(set(w for d in docs for w in d))
    return[[d.count(w) for w in v] for d in docs]
def perplexity(lps,n): return math.exp(-sum(lps)/n)
