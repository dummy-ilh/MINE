# Topo sort (Kahn's)
def topo(n,edges):
    g=defaultdict(list);ind=[0]*n
    for u,v in edges: g[u].append(v);ind[v]+=1
    q=deque(i for i in range(n) if ind[i]==0);order=[]
    while q:
        u=q.popleft();order.append(u)
        for v in g[u]:
            ind[v]-=1
            if ind[v]==0: q.append(v)
    return order if len(order)==n else []

# Dijkstra
def dijk(g,src,n):
    d=[float('inf')]*n;d[src]=0;h=[(0,src)]
    while h:
        dd,u=heapq.heappop(h)
        if dd>d[u]: continue
        for v,w in g[u]:
            if d[u]+w<d[v]: d[v]=d[u]+w;heapq.heappush(h,(d[v],v))
    return d
```

