def sdpa(Q,K,V,mask=None):
    d=len(Q[0]);scores=matmul(Q,[[K[j][i] for j in range(len(K))] for i in range(len(K[0]))])
    scores=[[v/math.sqrt(d) for v in r] for r in scores]
    if mask:
        for i in range(len(scores)):
            for j in range(len(scores[0])):
                if mask[i][j]: scores[i][j]=float('-inf')
    a=[softmax(r) for r in scores]
    return matmul(a,V)

def causal_mask(n): return[[1 if j>i else 0 for j in range(n)] for i in range(n)]

def pos_enc(T,d):
    PE=[[0.]*d for _ in range(T)]
    for p in range(T):
        for i in range(0,d,2):
            PE[p][i]=math.sin(p/10000**(i/d))
            if i+1<d: PE[p][i+1]=math.cos(p/10000**(i/d))
    return PE

def ffn(x,W1,b1,W2,b2):
    h=[max(0,sum(W1[i][j]*x[j] for j in range(len(x)))+b1[i]) for i in range(len(W1))]
    return[sum(W2[i][j]*h[j] for j in range(len(h)))+b2[i] for i in range(len(W2))]
# Multi-head: split Q,K,V into h chunks on d_k dim → sdpa each → concat
# KV cache: store past K,V, append new token's K,V each step
# RoPE: rotate Q,K by sin/cos of position before dot product
# FlashAttention: tile computation to avoid O(n²) memory materialization
