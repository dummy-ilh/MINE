```python
def mse(yt,yp): return sum((a-b)**2 for a,b in zip(yt,yp))/len(yt)
def bce(yt,yp,e=1e-9):
    return-sum(y*math.log(p+e)+(1-y)*math.log(1-p+e) for y,p in zip(yt,yp))/len(yt)
def huber(yt,yp,d=1):
    return sum(.5*abs(a-b)**2 if abs(a-b)<=d else d*(abs(a-b)-.5*d) for a,b in zip(yt,yp))/len(yt)
def kl(p,q,e=1e-9): return sum(pi*math.log((pi+e)/(qi+e)) for pi,qi in zip(p,q))
```

