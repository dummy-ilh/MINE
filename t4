def nms(boxes,scores,thr=.5):
    order=sorted(range(len(scores)),key=lambda i:scores[i],reverse=True);keep=[]
    while order:
        i=order.pop(0);keep.append(i)
        order=[j for j in order if iou(boxes[i],boxes[j])<thr]
    return keep

def beam_search(tok,nxt,w=3,ml=10):
    beams=[(0.,[tok])]
    for _ in range(ml):
        cands=[(s-math.log(p+1e-9),seq+[t]) for s,seq in beams for t,p in nxt(seq[-1])]
        beams=sorted(cands)[:w]
    return beams[0][1]

def temp_sample(logits,T=1.):
    p=softmax([l/T for l in logits]);r=random.random();cs=0
    for i,pi in enumerate(p):
        cs+=pi
        if r<=cs: return i
    return len(p)-1

def map_at_k(rel,ret,k):
    hits=ps=0
    for i,d in enumerate(ret[:k]):
        if d in rel: hits+=1;ps+=hits/(i+1)
    return ps/min(len(rel),k)

# VAE
def reparam(mu,lv): return mu+random.gauss(0,1)*math.exp(.5*lv)
def vae_loss(x,xr,mu,lv):
    recon=sum((a-b)**2 for a,b in zip(x,xr))/len(x)
    kl=-.5*sum(1+lv_i-mu_i**2-math.exp(lv_i) for mu_i,lv_i in zip(mu,lv))
    return recon+kl

# DDPM forward: x_t = sqrt(α_t)·x0 + sqrt(1-α_t)·ε
def ddpm_fwd(x0,t,ac):
    a=ac[t];e=[random.gauss(0,1) for _ in x0]
    return[math.sqrt(a)*x+math.sqrt(1-a)*ei for x,ei in zip(x0,e)],e
