# Linear Regression (GD)
class LinReg:
    def __init__(self,lr=.01,ep=1000): self.lr=lr;self.ep=ep;self.w=self.b=0
    def fit(self,X,y):
        n=len(y)
        for _ in range(self.ep):
            yp=[self.w*x+self.b for x in X]
            self.w-=self.lr*(-2/n*sum((y[i]-yp[i])*X[i] for i in range(n)))
            self.b-=self.lr*(-2/n*sum(y[i]-yp[i] for i in range(n)))
    def predict(self,X): return[self.w*x+self.b for x in X]

# Logistic Regression
class LogReg:
    def fit(self,X,y,lr=.01,ep=1000):
        n,d=len(X),len(X[0]);self.w=[0.]*d;self.b=0.
        for _ in range(ep):
            for i in range(n):
                z=sum(self.w[j]*X[i][j] for j in range(d))+self.b
                e=1/(1+math.exp(-z))-y[i]
                for j in range(d): self.w[j]-=lr*e*X[i][j]
                self.b-=lr*e
    def pred(self,x): z=sum(self.w[j]*x[j] for j in range(len(x)))+self.b;return 1/(1+math.exp(-z))

# KNN
class KNN:
    def fit(self,X,y): self.X=X;self.y=y
    def predict(self,x,k=3):
        d=sorted((sum((a-b)**2 for a,b in zip(x,xi))**.5,yi) for xi,yi in zip(self.X,self.y))
        lb=[yi for _,yi in d[:k]];return max(set(lb),key=lb.count)

# K-Means
def kmeans(X,k,it=100):
    c=random.sample(X,k)
    for _ in range(it):
        cl=[[] for _ in range(k)]
        for x in X: cl[min(range(k),key=lambda i:sum((a-b)**2 for a,b in zip(x,c[i])))].append(x)
        nc=[[sum(p[j] for p in g)/len(g) for j in range(len(X[0]))] if g else random.choice(X) for g in cl]
        if nc==c: break
        c=nc
    return c,cl

# Naive Bayes (Gaussian)
class NB:
    def fit(self,X,y):
        self.cls=set(y);n=len(y)
        self.pr={c:sum(1 for i in y if i==c)/n for c in self.cls}
        self.st={c:[(lambda col:(sum(col)/len(col),(sum((v-sum(col)/len(col))**2 for v in col)/len(col))**.5))(
            [X[i][j] for i in range(n) if y[i]==c]) for j in range(len(X[0]))] for c in self.cls}
    def pred(self,x):
        def g(v,u,s,e=1e-9): return math.exp(-.5*((v-u)/(s+e))**2)/((s+e)*(2*math.pi)**.5)
        return max(self.cls,key=lambda c:math.log(self.pr[c])+sum(math.log(g(x[j],*self.st[c][j])+1e-9) for j in range(len(x))))

# Decision Tree helpers
def entropy(y):
    n=len(y);f={}
    for l in y: f[l]=f.get(l,0)+1
    return-sum((c/n)*math.log2(c/n+1e-9) for c in f.values())
def gini_impurity(y):
    n=len(y);f={}
    for l in y: f[l]=f.get(l,0)+1
    return 1-sum((c/n)**2 for c in f.values())
def info_gain(p,l,r):
    n=len(p);return entropy(p)-(len(l)/n)*entropy(l)-(len(r)/n)*entropy(r)
